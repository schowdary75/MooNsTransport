# ═════════════════════════════════════════════════════════════════
# YatraMap - Global .gitignore
# ═════════════════════════════════════════════════════════════════

# ─── Dependencies ────────────────────────────────────────────────
node_modules/
.yarn/
pnpm-lock.yaml
package-lock.json
*.lock

# ─── Build & Dist ───────────────────────────────────────────────
dist/
build/
.next/
out/
.tsc
*.tsbuildinfo

# ─── IDE & Editor ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.env.local
.env.*.local

# ─── Environment ────────────────────────────────────────────────
.env
.env.test
.env.production
.env.local
.env.*.local

# ─── Logs ────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# ─── Testing ─────────────────────────────────────────────────────
coverage/
.nyc_output/
jest-coverage/

# ─── OS ──────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
*.pem
Thumbs.db

# ─── Docker ──────────────────────────────────────────────────────
docker-compose.override.yml

# ─── Turbo ───────────────────────────────────────────────────────
.turbo

# ─── Prisma ──────────────────────────────────────────────────────
prisma/migrations/
.env.migrations
.moon-db-seeded
