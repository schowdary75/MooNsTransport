# ═════════════════════════════════════════════════════════════════
# Moon Production Environment Variables
# DO NOT commit actual values to git - use Vercel/deployment secrets
# ═════════════════════════════════════════════════════════════════

# ─── DATABASE (Production MySQL) ────────────────────────────────
# Use a managed service like:
# - PlanetScale (MySQL compatible)
# - AWS RDS
# - DigitalOcean Managed Database
DATABASE_URL="mysql://username:password@host:3306/moon_production"

# ─── APP CONFIGURATION ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_API_URL="https://yourdomain.com/api"
NODE_ENV="production"

# ─── CLERK AUTHENTICATION (Production) ──────────────────────────
# Get these from Clerk Dashboard > API Keys > Production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_production_key"
CLERK_SECRET_KEY="sk_live_your_production_secret"
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret"

# ─── REDIS / UPSTASH ────────────────────────────────────────────
# Use Upstash.com free tier or managed Redis
REDIS_URL="redis://default:password@your-host:6379"
UPSTASH_REDIS_REST_URL="https://your-instance-prod.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_production_token"

# ─── MAPS & ROUTING ─────────────────────────────────────────────
# OpenTripPlanner can be:
# - Self-hosted Docker container
# - AWS Fargate service
# - Third-party OTP service
NEXT_PUBLIC_OTP_API_URL="https://routing-api.yourdomain.com"
NOMINATIM_URL="https://nominatim.openstreetmap.org"
NEXT_PUBLIC_MAP_CENTER_LAT="28.6139"
NEXT_PUBLIC_MAP_CENTER_LNG="77.2090"

# ─── PAYMENTS (Razorpay - Production) ───────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_production_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_production_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ─── NOTIFICATIONS (Firebase - Production) ──────────────────────
# Get from: Firebase Console > Project Settings > Service Accounts
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id-prod"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:your_app_id:web:your_web_id"
FIREBASE_ADMIN_SDK_KEY='{"type":"service_account","project_id":"your-project-id-prod",...}'

# Email delivery via Resend
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_production_api_key"

# SMS delivery via MSG91
# Get from: https://msg91.com/user/api
MSG91_API_KEY="your_msg91_api_key"
MSG91_ROUTE="your_msg91_route_id"

# ─── FLIGHTS (Amadeus - Production) ─────────────────────────────
# Get from: https://developers.amadeus.com/
# Note: Use live API endpoints, not sandbox
AMADEUS_CLIENT_ID="your_amadeus_production_client_id"
AMADEUS_CLIENT_SECRET="your_amadeus_production_client_secret"

# ─── MONITORING (Sentry - Production) ───────────────────────────
# Get from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/your-project-id"
SENTRY_ENVIRONMENT="production"
SENTRY_ENABLED="true"
