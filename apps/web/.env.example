# ═════════════════════════════════════════════════════════════════
# YatraMap Environment Variables
# Copy this file to .env.local and fill in your own values
# ═════════════════════════════════════════════════════════════════

# ─── DATABASE ───────────────────────────────────────────────────
DATABASE_URL="mysql://yatramap:yatramap123@localhost:3306/yatramap"

# ─── CLERK AUTHENTICATION ───────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── REDIS / UPSTASH ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ─── MAPS & ROUTING ─────────────────────────────────────────────
NEXT_PUBLIC_OTP_API_URL=http://localhost:8080
NOMINATIM_URL=https://nominatim.openstreetmap.org
NEXT_PUBLIC_MAP_CENTER_LAT=28.6139
NEXT_PUBLIC_MAP_CENTER_LNG=77.2090

# ─── PAYMENTS ───────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── NOTIFICATIONS ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaS...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc...

FIREBASE_ADMIN_SDK_KEY={"type":"service_account",...}

RESEND_API_KEY=re_your_resend_api_key

MSG91_API_KEY=your_msg91_api_key
MSG91_ROUTE=your_msg91_route

# ─── FLIGHTS ────────────────────────────────────────────────────
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# ─── MONITORING ─────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_ENABLED=false

# ─── GENERAL ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NODE_ENV=development
