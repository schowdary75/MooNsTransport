{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "DATABASE_URL": {
      "type": "secret",
      "description": "MySQL database connection string"
    },
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": {
      "type": "secret",
      "description": "Clerk publishable key for authentication"
    },
    "CLERK_SECRET_KEY": {
      "type": "secret",
      "description": "Clerk secret key"
    },
    "CLERK_WEBHOOK_SECRET": {
      "type": "secret",
      "description": "Clerk webhook secret for user sync"
    },
    "REDIS_URL": {
      "type": "secret",
      "description": "Redis connection string (Upstash)"
    },
    "UPSTASH_REDIS_REST_URL": {
      "type": "secret",
      "description": "Upstash Redis REST API URL"
    },
    "UPSTASH_REDIS_REST_TOKEN": {
      "type": "secret",
      "description": "Upstash Redis REST token"
    },
    "NEXT_PUBLIC_FIREBASE_API_KEY": {
      "type": "secret"
    },
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": {
      "type": "secret"
    },
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": {
      "type": "secret"
    },
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": {
      "type": "secret"
    },
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": {
      "type": "secret"
    },
    "NEXT_PUBLIC_FIREBASE_APP_ID": {
      "type": "secret"
    },
    "FIREBASE_ADMIN_SDK_KEY": {
      "type": "secret"
    },
    "NEXT_PUBLIC_RAZORPAY_KEY_ID": {
      "type": "secret"
    },
    "RAZORPAY_KEY_SECRET": {
      "type": "secret"
    },
    "RAZORPAY_WEBHOOK_SECRET": {
      "type": "secret"
    },
    "RESEND_API_KEY": {
      "type": "secret"
    },
    "MSG91_API_KEY": {
      "type": "secret"
    },
    "MSG91_ROUTE": {
      "type": "secret"
    },
    "AMADEUS_CLIENT_ID": {
      "type": "secret"
    },
    "AMADEUS_CLIENT_SECRET": {
      "type": "secret"
    },
    "NEXT_PUBLIC_OTP_API_URL": {
      "type": "secret",
      "description": "OpenTripPlanner API endpoint"
    },
    "NEXT_PUBLIC_SENTRY_DSN": {
      "type": "secret"
    },
    "SENTRY_ENVIRONMENT": {
      "type": "constant",
      "value": "production"
    },
    "SENTRY_ENABLED": {
      "type": "constant",
      "value": "true"
    },
    "NODE_ENV": {
      "type": "constant",
      "value": "production"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
